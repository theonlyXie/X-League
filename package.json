    "@react-native-async-storage/async-storage": "~2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
