{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // The admin dashboard is a separate Next.js project with its own tsconfig
  // and its own `@/*` root. Typechecking it from here resolves its imports
  // against the app's paths and invents errors that do not exist.
  "exclude": ["node_modules", "admin"]
}
