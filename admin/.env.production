# Build-time configuration for the deployed dashboard.
#
# Both values are publishable by design and already ship inside every APK —
# NEXT_PUBLIC_* is inlined into the browser bundle, so a "secret" here would be
# no secret at all. The service-role key is not used by this project, or by any
# other part of this repository.
#
# Committed so that a deployment built from this repository is configured
# without anybody having to remember two environment variables. Override them
# in the Vercel project to point a deployment at a different database.
NEXT_PUBLIC_SUPABASE_URL=https://ymuknkhapibmtqkrlmia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Se0BSDnjn_PcJ7__inqR8A_drC0vZ-h
