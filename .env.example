# Point the app at a database. Without these the app runs on the seeded
# fixtures instead (demo mode) — see src/lib/supabase.ts.
#
# EXPO_PUBLIC_ vars are embedded in the client bundle, so only the anon key
# belongs here. The service-role key must never appear in this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The seeded venue the app currently points at. Once venue discovery is wired
# these come from the search result the player tapped instead.
#   select id from venue where name = 'Stadium One';
#   select p.id from pitch p join venue v on v.id = p.venue_id
#    where v.name = 'Stadium One' and p.label = 'Pitch A';
EXPO_PUBLIC_VENUE_ID=
EXPO_PUBLIC_PITCH_ID=

# Phone OTP needs an SMS provider configured under
# Authentication -> Providers -> Phone in the Supabase dashboard. Without one,
# auth/v1/otp answers phone_provider_disabled and the sign-in screen says so.
